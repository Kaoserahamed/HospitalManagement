# Backend Environment Variables
# Copy to `backend/.env` for local development (never commit that file).
# In deployed environments these are injected by the platform / Kubernetes.

# -- Application -------------------------------------------------------------
# One of: local | test | staging | production
ENVIRONMENT=local
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -- Database (required) -------------------------------------------------------
DATABASE_URL=mysql+asyncmy://username:password@host:3306/database_name
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# -- Security (required) --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 chars in production.
SECRET_KEY=generate-a-secure-random-string-with-the-command-above
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -- CORS ------------------------------------------------------------------------
# Comma-separated explicit origins. Wildcards are rejected by validation.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

